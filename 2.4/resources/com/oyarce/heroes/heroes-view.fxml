<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="158.0" prefWidth="180.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.oyarce.heroes.controller.HeroesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <HBox prefHeight="100.0" prefWidth="200.0" spacing="10">
        <TextField fx:id="txtId" promptText="ID"/>
        <TextField fx:id="txtNombre" promptText="Nombre"/>
        <Button onMouseClicked="#handleCrear" text="Crear"/>
    </HBox>
    <TableView fx:id="tableHeroes" onMouseClicked="#handleSelecionado">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
        </columns>
    </TableView>
</VBox>
